    def on_toggle_warp(self, switch, *args):
        active = switch.get_active()
        if active:
            self.start_warp()
        else:
            self.stop_warp()
        self.save_warp_state()

    def save_warp_state(self):
        try:
            with open(WARP_STATE_FILE, "w") as f:
                f.write("1" if self.warp_switch.get_active() else "0")
        except OSError:
            pass

    def load_warp_state(self):
        try:
            r = subprocess.run(
                ["systemctl", "--user", "is-active", WARP_SERVICE],
                capture_output=True, timeout=5,
            )
            active = r.stdout.decode().strip() == "active"

            try:
                with open(WARP_STATE_FILE) as f:
                    pref = f.read().strip()
            except (OSError, FileNotFoundError):
                pref = "1" if active else "0"

            r2 = subprocess.run(
                ["systemctl", "--user", "is-enabled", WARP_SERVICE],
                capture_output=True, timeout=5,
            )
            enabled = r2.stdout.decode().strip() == "enabled"

            if pref == "1" and not enabled:
                subprocess.run(
                    ["systemctl", "--user", "enable", WARP_SERVICE],
                    capture_output=True, timeout=5,
                )
            elif pref == "0" and enabled:
                subprocess.run(
                    ["systemctl", "--user", "disable", WARP_SERVICE],
                    capture_output=True, timeout=5,
                )

            self.warp_switch.set_active(active)
        except Exception:
            logging.exception("Error en load_warp_state")

    def start_warp(self):
        subprocess.run(
            ["systemctl", "--user", "enable", "--now", WARP_SERVICE],
            capture_output=True, timeout=5,
        )
        logging.info("Easy Pointer iniciado")

    def stop_warp(self):
        subprocess.run(
            ["systemctl", "--user", "disable", "--now", WARP_SERVICE],
            capture_output=True, timeout=5,
        )
        logging.info("Easy Pointer detenido")


