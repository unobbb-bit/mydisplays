def get_monitors():
    result = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True)
    monitors = json.loads(result.stdout)
    out = []
    for m in monitors:
        out.append({
            "name": m["name"],
            "width": m["width"],
            "height": m["height"],
            "refresh": round(m["refreshRate"]),
            "scale": m["scale"],
            "x": m["x"],
            "y": m["y"],
            "transform": m.get("transform", 0),
        })
    return out


def get_monitor_modes(name):
    result = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True)
    monitors = json.loads(result.stdout)
    for m in monitors:
        if m["name"] == name:
            modes = m.get("availableModes", [])
            cleaned = []
            for mode in modes:
                mode = mode.strip()
                if mode.endswith("Hz"):
                    mode = mode[:-2].strip()
                cleaned.append(mode)
            return cleaned
    return []


def mode_matches(mode_str, width, height, refresh):
    parts = mode_str.split("@")
    if len(parts) != 2:
        return False
    res = parts[0].strip()
    hz = parts[1].strip()
    expected_res = f"{width}x{height}"
    if res != expected_res:
        return False
    try:
        return abs(float(hz) - refresh) < 1.0
    except ValueError:
        return False


def mode_to_resolution(mode_str):
    parts = mode_str.split("@")
    res = parts[0].strip()
    hz = float(parts[1].strip()) if len(parts) > 1 else 60
    w, h = res.split("x")
    return int(w), int(h), round(hz)


def serialize_monitors(monitors):
    lines = [
        "# See https://wiki.hypr.land/Configuring/Basics/Monitors/",
        "# Auto-generado por MyDisplays",
        "",
    ]
    for m in monitors:
        res = f"{m['width']}x{m['height']}@{m['refresh']}"
        pos = f"{m['x']}x{m['y']}"
        scale = m["scale"]
        transform = m.get("transform", 0)
        line = f"monitor={m['name']},{res},{pos},{scale}"
        if transform:
            line += f",transform,{transform}"
        lines.append(line)
    return "\n".join(lines) + "\n"


def hyprctl_reload():
    result = subprocess.run(["hyprctl", "reload"], capture_output=True, text=True)
    err_result = subprocess.run(["hyprctl", "configerrors"], capture_output=True, text=True)
    errors = err_result.stdout.strip()
    if result.returncode != 0:
        return False, result.stderr
    if errors and errors != "ok":
        return False, errors
    return True, ""


class MonitorCanvas(Gtk.DrawingArea):
    def __init__(self):
        super().__init__()
        self.set_hexpand(True)
        self.set_vexpand(True)
        self.set_draw_func(self.on_draw)
        self.monitors = []
        self.dragging = None
        self._pos_snapshot = {}
        self.drag_offset_x = 0
        self.drag_offset_y = 0
        self.base_scale = 0.12
        self.scale_factor = self.base_scale
        self.zoom_percent = 100
        self.offset_x = 30
        self.offset_y = 30
        self.selected_name = None
        self._anim_name = None
        self._anim_forward = True
        self.anim_progress = 0.0
        self.anim_source = None
        self._extra_top = 0.0
        self._extra_top_from = 0.0
        self._extra_top_to = 0.0
        self._extra_top_anim = None
        self._extra_top_start = 0
        self.overlap_rects = []
        self.has_overlap = False
        self.overlap_phase = 0
        self.overlap_anim_source = None
        self._text_alpha = 1.0
        self._text_alpha_from = 1.0
        self._text_alpha_to = 1.0
        self._text_alpha_start = 0
        self._text_alpha_anim = None
        self.on_zoom_changed = None

        click_gesture = Gtk.GestureClick()
        click_gesture.connect("pressed", self.on_click_pressed)
        click_gesture.connect("released", self.on_click_released)
        self.add_controller(click_gesture)

        motion_controller = Gtk.EventControllerMotion()
        motion_controller.connect("motion", self.on_motion)
        self.add_controller(motion_controller)

    def compute_layout(self):
        if not self.monitors:
            return
        sf = self.scale_factor
        side = 75
        top = 75 + int(self._extra_top)
        min_vx = min(m["x"] * sf for m in self.monitors)
        min_vy = min(m["y"] * sf for m in self.monitors)
        max_vx = max((m["x"] + m["width"] / m["scale"]) * sf for m in self.monitors)
        max_vy = max((m["y"] + m["height"] / m["scale"]) * sf for m in self.monitors)
        cw = int(max_vx - min_vx + 2 * side)
        ch = int(max_vy - min_vy + side + top)
        self.set_size_request(max(cw, 100), max(ch, 100))
        self.offset_x = side - min_vx
        self.offset_y = top - min_vy
        self.update_overlaps()

    def set_monitors(self, monitors):
        self.monitors = monitors
        self.compute_layout()
        self.ensure_clear_overlay()
        self.queue_draw()

    def adjust_zoom(self, delta):
        if self._extra_top_anim:
            GLib.source_remove(self._extra_top_anim)
            self._extra_top_anim = None
        self._extra_top = 0
        self._extra_top_to = 0
        zmax = 300
        if delta > 0 and self.zoom_percent >= 50 and self._text_alpha < 1.0 and self._text_alpha_to == 1.0:
            zmax = 50
        self.zoom_percent = max(20, min(zmax, self.zoom_percent + delta))
        self.scale_factor = self.base_scale * (self.zoom_percent / 100)
        self.compute_layout()
        self.queue_draw()
        if self.on_zoom_changed:
            self.on_zoom_changed(self.zoom_percent)

        if self.zoom_percent <= 40:
            self._start_text_fade(0.0)
        elif self.zoom_percent >= 50:
            self._start_text_fade(1.0)

    def select_monitor(self, name):
        if self.selected_name == name:
            return
        self.selected_name = name
        self._anim_name = name
        self.start_anim(forward=True)
        self.queue_draw()

    def deselect_monitor(self):
        if self.selected_name is None:
            return
        self._anim_name = self.selected_name
        self.selected_name = None
        self.start_anim(forward=False)

    def start_anim(self, forward=True):
        if self.anim_source:
            GLib.source_remove(self.anim_source)
        self._anim_forward = forward
        self.anim_progress = 0.0 if forward else 1.0
        self._anim_start = GLib.get_monotonic_time()
        self.anim_source = GLib.timeout_add(16, self.tick_anim)

    def tick_anim(self):
        elapsed_us = GLib.get_monotonic_time() - self._anim_start
        raw_p = min(1.0, elapsed_us / 500000)
        if self._anim_forward:
            self.anim_progress = raw_p
        else:
            self.anim_progress = 1.0 - raw_p
        self.queue_draw()
        if raw_p >= 1.0:
            self.anim_source = None
            return False
        return True

    def get_monitor_at(self, view_x, view_y):
        ox = self.offset_x
        oy = self.offset_y
        sf = self.scale_factor
        for m in sorted(self.monitors, key=lambda x: -x["y"]):
            lw = m["width"] / m["scale"]
            lh = m["height"] / m["scale"]
            mx = ox + m["x"] * sf
            my = oy + m["y"] * sf
            mw = lw * sf
            mh = lh * sf
            if mx <= view_x <= mx + mw and my <= view_y <= my + mh:
                return m
        return None

    def on_click_pressed(self, gesture, n_press, vx, vy):
        m = self.get_monitor_at(vx, vy)
        if m:
            self.dragging = m
            if self._extra_top > 0:
                self._extra_top = 0
                self._extra_top_to = 0
                if self._extra_top_anim:
                    GLib.source_remove(self._extra_top_anim)
                    self._extra_top_anim = None
                self.compute_layout()
                self.queue_draw()
            self._pos_snapshot = {mm["name"]: (mm["x"], mm["y"]) for mm in self.monitors}
            ox = self.offset_x
            oy = self.offset_y
            sf = self.scale_factor
            self.drag_offset_x = vx - (ox + m["x"] * sf)
            self.drag_offset_y = vy - (oy + m["y"] * sf)
            self.select_monitor(m["name"])
            win = self.get_native()
            if win and hasattr(win, "select_monitor_by_name"):
                win.select_monitor_by_name(m["name"])
        else:
            self.deselect_monitor()

    def ease_in_out(self, t):
        if t < 0.5:
            return 2 * t * t
        return -1 + (4 - 2 * t) * t

    def ensure_clear_overlay(self):
        win = self.get_native()
        if not win or not hasattr(win, "scrolled"):
            return
        sw = win.scrolled
        scroll_y = sw.get_vadjustment().get_value()
        overlay_h = 50
        sf = self.scale_factor
        min_y = min(self.offset_y + m["y"] * sf for m in self.monitors)
        visible_top = min_y - scroll_y
        if visible_top >= overlay_h:
            if self._extra_top > 0 or self._extra_top_anim:
                if self._extra_top_anim:
                    GLib.source_remove(self._extra_top_anim)
                self._extra_top_from = self._extra_top
                self._extra_top_to = 0
                self._extra_top_start = GLib.get_monotonic_time()
                self._extra_top_anim = GLib.timeout_add(16, self.tick_extra_top_anim)
            return
        visible_top = max(visible_top, -overlay_h)
        needed = math.ceil((overlay_h - visible_top) / sf) + 8
        needed_px = needed * sf
        current = self._extra_top_to if self._extra_top_anim else self._extra_top
        if abs(needed_px - current) < 0.5:
            return
        if self._extra_top_anim:
            GLib.source_remove(self._extra_top_anim)
        self._extra_top_from = self._extra_top
        self._extra_top_to = needed_px
        self._extra_top_start = GLib.get_monotonic_time()
        self._extra_top_anim = GLib.timeout_add(16, self.tick_extra_top_anim)

    def tick_extra_top_anim(self):
        elapsed_us = GLib.get_monotonic_time() - self._extra_top_start
        p = min(1.0, elapsed_us / 500000)
        eased = self.ease_in_out(p)
        self._extra_top = self._extra_top_from + (self._extra_top_to - self._extra_top_from) * eased
        self.compute_layout()
        self.queue_draw()
        if p >= 1.0:
            self._extra_top = self._extra_top_to
            self._extra_top_anim = None
            self.compute_layout()
            self.queue_draw()
            win = self.get_native()
            if win and hasattr(win, "refresh_overlap_warning"):
                win.refresh_overlap_warning()
            return False
        return True

    def _start_text_fade(self, target):
        if self._text_alpha_to == target:
            return
        if self._text_alpha == target:
            return
        if self._text_alpha_anim:
            GLib.source_remove(self._text_alpha_anim)
        self._text_alpha_from = self._text_alpha
        self._text_alpha_to = target
        self._text_alpha_start = GLib.get_monotonic_time()
        self._text_alpha_anim = GLib.timeout_add(16, self._tick_text_alpha)

    def _tick_text_alpha(self):
        elapsed_us = GLib.get_monotonic_time() - self._text_alpha_start
        p = min(1.0, elapsed_us / 500000)
        eased = self.ease_in_out(p)
        self._text_alpha = self._text_alpha_from + (self._text_alpha_to - self._text_alpha_from) * eased
        self.queue_draw()
        if p >= 1.0:
            self._text_alpha = self._text_alpha_to
            self._text_alpha_anim = None
            self.queue_draw()
            return False
        return True

    def on_click_released(self, gesture, n_press, vx, vy):
        if self.dragging:
            old = self._pos_snapshot.get(self.dragging["name"])
            if old and (old[0] != self.dragging["x"] or old[1] != self.dragging["y"]):
                win = self.get_native()
                if win and hasattr(win, "on_canvas_drag"):
                    win.dragging_block = True
                    win.on_canvas_drag(self.dragging)
                    win.dragging_block = False
        self.dragging = None
        self._pos_snapshot = {}
        self.ensure_clear_overlay()
        self.snap_monitors()
        self.update_overlaps()
        self.queue_draw()
        win = self.get_native()
        if win and hasattr(win, "refresh_overlap_warning"):
            win.refresh_overlap_warning()


    def on_motion(self, controller, vx, vy):
        if self.dragging:
            ox = self.offset_x
            oy = self.offset_y
            sf = self.scale_factor
            new_x = (vx - ox - self.drag_offset_x) / sf
            new_y = (vy - oy - self.drag_offset_y) / sf
            win = self.get_native()
            freeze_y = win and hasattr(win, "scrolled") and vy - win.scrolled.get_vadjustment().get_value() <= 50
            target_y = self.dragging["y"] if freeze_y else new_y
            clamped_x, clamped_y = self.clamp_position(self.dragging, new_x, target_y)
            clamped_x, clamped_y = self.clamp_max_distance(self.dragging, clamped_x, clamped_y)
            self.dragging["x"] = round(clamped_x)
            self.dragging["y"] = round(clamped_y)
            self.queue_draw()

    def clamp_position(self, m, new_x, new_y):
        return geom.clamp_position(self.monitors, m, new_x, new_y)

    def snap_monitors(self):
        if geom.snap_monitors(self.monitors):
            self.compute_layout()
            self.queue_draw()
            win = self.get_native()
            if win and hasattr(win, "refresh_overlap_warning"):
                win.refresh_overlap_warning()

    MAX_DIST = 10000

    def clamp_max_distance(self, m, new_x, new_y):
        m_w = m["width"] / m["scale"]
        m_h = m["height"] / m["scale"]
        m_cx = new_x + m_w / 2
        m_cy = new_y + m_h / 2
        for other in self.monitors:
            if other is m:
                continue
            o_w = other["width"] / other["scale"]
            o_h = other["height"] / other["scale"]
            o_cx = other["x"] + o_w / 2
            o_cy = other["y"] + o_h / 2
            dx = m_cx - o_cx
            dy = m_cy - o_cy
            dist = (dx * dx + dy * dy) ** 0.5
            if dist > self.MAX_DIST:
                scale = self.MAX_DIST / dist
                new_cx = o_cx + dx * scale
                new_cy = o_cy + dy * scale
                return new_cx - m_w / 2, new_cy - m_h / 2
        return new_x, new_y

    def update_overlaps(self):
        self.overlap_rects = []
        for i, a in enumerate(self.monitors):
            for b in self.monitors[i + 1:]:
                a_h = a["height"] / a["scale"]
                a_w = a["width"] / a["scale"]
                b_h = b["height"] / b["scale"]
                b_w = b["width"] / b["scale"]
                ix = max(a["x"], b["x"])
                iy = max(a["y"], b["y"])
                ir = min(a["x"] + a_w, b["x"] + b_w)
                ib = min(a["y"] + a_h, b["y"] + b_h)
                if ix < ir and iy < ib:
                    self.overlap_rects.append((ix, iy, ir - ix, ib - iy))
        self.has_overlap = len(self.overlap_rects) > 0
        if self.has_overlap:
            if self.overlap_anim_source is None:
                self.overlap_anim_source = GLib.timeout_add(50, self.advance_overlap_anim)
        else:
            if self.overlap_anim_source is not None:
                GLib.source_remove(self.overlap_anim_source)
                self.overlap_anim_source = None
            self.overlap_phase = 0

    def advance_overlap_anim(self):
        if not self.has_overlap:
            self.overlap_anim_source = None
            return False
        self.overlap_phase = (self.overlap_phase + 1) % 20
        self.queue_draw()
        return True

    def on_draw(self, area, cr, w, h):
        cr.set_source_rgb(0.07, 0.07, 0.09)
        cr.paint()

        if not self.monitors:
            cr.set_source_rgb(0.5, 0.5, 0.5)
            cr.set_font_size(14)
            cr.move_to(20, 30)
            cr.show_text(_("No hay monitores"))
            return

        ox = self.offset_x
        oy = self.offset_y
        sf = self.scale_factor

        for m in self.monitors:
            lw = m["width"] / m["scale"]
            lh = m["height"] / m["scale"]
            mw = max(lw * sf, 20)
            mh = max(lh * sf, 20)
            mx = ox + m["x"] * sf
            my = oy + m["y"] * sf

            if m["name"] == self.selected_name:
                cr.set_source_rgb(0.4, 0.6, 0.9)
            else:
                cr.set_source_rgb(0.15, 0.22, 0.38)
            r = 3
            cr.new_sub_path()
            cr.arc(mx + r, my + r, r, math.pi, 3 * math.pi / 2)
            cr.arc(mx + mw - r, my + r, r, 3 * math.pi / 2, 2 * math.pi)
            cr.arc(mx + mw - r, my + mh - r, r, 0, math.pi / 2)
            cr.arc(mx + r, my + mh - r, r, math.pi / 2, math.pi)
            cr.close_path()
            cr.fill()

            if mw > 40 and mh > 30:
                ta = self._text_alpha
                if ta < 0.01:
                    continue
                p = self.anim_progress
                is_anim = m["name"] == self._anim_name

                name_size = max(7, min(18, int(mw / 10)))
                if is_anim:
                    name_size += int(p * 4)
                    y_off = p * 6
                    sub_alpha = min(1.0 - p, ta)
                else:
                    y_off = 0
                    sub_alpha = ta

                cr.select_font_face("Sans", 0, 1)
                cr.set_font_size(name_size)
                cr.set_source_rgba(0.8, 0.85, 0.95, ta)
                te = cr.text_extents(m["name"])
                tx = mx + (mw - te.width) / 2
                ty = my + (mh - te.height) / 2 - 6 + y_off
                cr.move_to(tx, ty)
                cr.show_text(m["name"])

                if sub_alpha > 0.01:
                    sub_size = max(6, min(11, int(mw / 16)))
                    cr.select_font_face("Sans", 0, 0)
                    cr.set_font_size(sub_size)
                    cr.set_source_rgba(0.6, 0.65, 0.75, sub_alpha)
                    sub = _("Seleccionar para editar")
                    te = cr.text_extents(sub)
                    tx = mx + (mw - te.width) / 2
                    ty = my + (mh - te.height) / 2 + 14
                    cr.move_to(tx, ty)
                    cr.show_text(sub)

        if self.has_overlap:
            alpha = self.overlap_phase / 20.0
            cr.set_source_rgba(0.9, 0.1, 0.1, alpha * 0.5)
            for rx, ry, rw, rh in self.overlap_rects:
                cr.rectangle(ox + rx * sf, oy + ry * sf, rw * sf, rh * sf)
                cr.fill()


class MyDisplaysWindow(Adw.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.set_title(_("MyDisplays"))
        self.set_default_size(1000, 650)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.DEFAULT)
        self.setup_logging()
        self.setup_css()
        self.setup_ui()
        self.current_monitor = None
        self.dragging_block = False
        self._editing_block = False
        self._dirty = False
        self._saved_state = []
        self._is_portrait = False
        self.refresh_monitors()
        self._saved_state = copy.deepcopy(self.monitors)

        kc = Gtk.EventControllerKey()
        kc.connect("key-pressed", self.on_key_pressed)
        self.add_controller(kc)

    def setup_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS_EXTRA)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def setup_logging(self):
        os.makedirs(PROFILES_DIR, exist_ok=True)
