    def would_overlap_size(self, m, new_w, new_h):
        m_w = new_w / m["scale"]
        m_h = new_h / m["scale"]
        for other in self.monitors:
            if other is m:
                continue
            o_h = other["height"] / other["scale"]
            o_w = other["width"] / other["scale"]
            if (m["x"] < other["x"] + o_w and m["x"] + m_w > other["x"]
                    and m["y"] < other["y"] + o_h and m["y"] + m_h > other["y"]):
                return True
        return False

    def on_edit_changed(self, entry, *args):
        if getattr(self, "dragging_block", False):
            return
        if getattr(self, "_editing_block", False):
            return
        if not self.current_monitor:
            return
        m = self.current_monitor
        new_scale = m["scale"]
        new_x = m["x"]
        new_y = m["y"]
        try:
            new_scale = float(self.scale_entry.get_text())
        except ValueError:
            pass
        try:
            new_x = int(self.posx_entry.get_text())
        except ValueError:
            pass
        try:
            new_y = int(self.posy_entry.get_text())
        except ValueError:
            pass
        if self.would_overlap(m, new_x, new_y, new_scale):
            self._editing_block = True
            if entry is self.scale_entry:
                self.scale_entry.set_text(str(m["scale"]))
            elif entry is self.posx_entry:
                self.posx_entry.set_text(str(m["x"]))
            elif entry is self.posy_entry:
                self.posy_entry.set_text(str(m["y"]))
            self._editing_block = False
            return
        m["scale"] = new_scale
        m["x"] = new_x
        m["y"] = new_y
        self.canvas.queue_draw()
        self.canvas.snap_monitors()
        self.mark_dirty()

    def would_overlap(self, m, new_x, new_y, new_scale):
        m_h = m["height"] / new_scale
        m_w = m["width"] / new_scale
        for other in self.monitors:
            if other is m:
                continue
            o_h = other["height"] / other["scale"]
            o_w = other["width"] / other["scale"]
            if (new_x < other["x"] + o_w and new_x + m_w > other["x"]
                    and new_y < other["y"] + o_h and new_y + m_h > other["y"]):
                return True
        return False

    def on_save(self, *args):
        if not self._dirty:
            return
        self.sync_combo_to_monitor()
        if os.path.exists(MONITOR_CONF):
            shutil.copy2(MONITOR_CONF, PRECONF)
        save_monitors_config(self.monitors)
        ok, output = hyprctl_reload()
        if not ok:
            if os.path.exists(PRECONF):
                shutil.copy2(PRECONF, MONITOR_CONF)
                hyprctl_reload()
            show_dialog(self, _("Error al aplicar configuración"), output)
            logging.error(_("Error al guardar: {}").format(output))
            self.refresh_monitors()
            return

        logging.info(_("Config guardada en monitors.conf | reload OK"))

        dialog = Adw.MessageDialog.new(
            self,
            _("¿Funciona correctamente?"),
            _("Se revertirá en 10 segundos si no confirmas."),
        )
        dialog.add_response("no", _("Revertir"))
        dialog.add_response("yes", _("Sí, mantener"))
        dialog.set_default_response("yes")
        dialog.set_response_appearance("yes", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_appearance("no", Adw.ResponseAppearance.DESTRUCTIVE)

        timeout_id = [None]
        expired = [False]
        remaining = [10]

        label = Gtk.Label(label="10")
        label.set_margin_top(8)
        dialog.set_extra_child(label)

        tick_cb = [None]

        def on_tick():
            remaining[0] -= 1
            label.set_text(str(remaining[0]))
            if remaining[0] <= 0:
                expired[0] = True
                self.restore_and_log_save()
                dialog.close()
                return False
            return True

        tick_cb[0] = GLib.timeout_add(1000, on_tick)

        def on_response(d, resp):
            if tick_cb[0]:
                GLib.source_remove(tick_cb[0])
                tick_cb[0] = None
            if expired[0]:
                return
            if resp == "yes":
                if os.path.exists(PRECONF):
                    os.remove(PRECONF)
                self.clear_dirty()
                self.toast_overlay.add_toast(Adw.Toast(title=_("Configuración guardada")))
                self.refresh_monitors()
            else:
                self.restore_and_log_save()
            d.close()

        def on_close():
            if tick_cb[0]:
                GLib.source_remove(tick_cb[0])
                tick_cb[0] = None
            if not expired[0]:
                self.restore_and_log_save()

        dialog.connect("response", on_response)
        dialog.connect("close-request", on_close)
        dialog.present()

    def restore_and_log_save(self):
        if os.path.exists(PRECONF):
            shutil.copy2(PRECONF, MONITOR_CONF)
            hyprctl_reload()
            os.remove(PRECONF)
            self.toast_overlay.add_toast(Adw.Toast(title=_("Cambios revertidos")))
            logging.info(_("Save revertido"))
        self.refresh_monitors()
        self.canvas.queue_draw()

    def sync_combo_to_monitor(self):
        if not self.current_monitor:
            return
        model = self.res_combo.get_model()
        if model:
            pos = self.res_combo.get_selected()
            if pos != Gtk.INVALID_LIST_POSITION:
                mode = model.get_string(pos)
                w, h, hz = mode_to_resolution(mode)
                self.current_monitor["width"] = w
                self.current_monitor["height"] = h
                self.current_monitor["refresh"] = hz
        rp = self.rot_combo.get_selected()
        base_rot = 0
        if rp != Gtk.INVALID_LIST_POSITION:
            base_rot = self.rot_options[rp][1]
        mirrored = self.mirror_switch.get_active()
        self.current_monitor["transform"] = base_rot + (4 if mirrored else 0)

