def show_identify_overlay(app, name, mon_w, mon_h):
    font_size = max(36, min(96, mon_h // 10))

    css = Gtk.CssProvider()
    css.load_from_string(f"""
        window.identify-overlay {{
            background: rgba(0, 0, 0, 0.7);
            border-radius: 12px;
        }}
        window.identify-overlay label {{
            font-size: {font_size}px;
            font-weight: bold;
            color: white;
        }}
    """)
    display = Gdk.Display.get_default()
    if display:
        Gtk.StyleContext.add_provider_for_display(
            display, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    win = Gtk.Window(application=app)
    win.add_css_class("identify-overlay")
    Gtk4LayerShell.init_for_window(win)
    Gtk4LayerShell.set_layer(win, Gtk4LayerShell.Layer.OVERLAY)
    Gtk4LayerShell.set_anchor(win, Gtk4LayerShell.Edge.TOP, True)
    Gtk4LayerShell.set_anchor(win, Gtk4LayerShell.Edge.BOTTOM, True)
    Gtk4LayerShell.set_anchor(win, Gtk4LayerShell.Edge.LEFT, True)
    Gtk4LayerShell.set_anchor(win, Gtk4LayerShell.Edge.RIGHT, True)
    Gtk4LayerShell.set_keyboard_mode(win, Gtk4LayerShell.KeyboardMode.NONE)
    Gtk4LayerShell.set_namespace(win, "mydisplays-identify")

    if display:
        for m in display.get_monitors():
            connector = getattr(m, "get_connector", lambda: None)()
            if connector and connector.lower() == name.lower():
                Gtk4LayerShell.set_monitor(win, m)
                break

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    label = Gtk.Label(label=name)
    label.set_halign(Gtk.Align.CENTER)
    label.set_valign(Gtk.Align.CENTER)
    label.set_hexpand(True)
    label.set_vexpand(True)
    box.append(label)
    win.set_child(box)

    click = Gtk.GestureClick()
    click.connect("pressed", lambda *a: win.close())
    win.add_controller(click)

    win.set_opacity(0.0)
    win.present()

    start_us = GLib.get_monotonic_time()

    def tick():
        elapsed_ms = (GLib.get_monotonic_time() - start_us) / 1000
        if elapsed_ms < 300:
            win.set_opacity(elapsed_ms / 300.0)
            return GLib.SOURCE_CONTINUE
        win.set_opacity(1.0)
        GLib.timeout_add_seconds(4, win.close)
        return GLib.SOURCE_REMOVE

    GLib.timeout_add(16, tick)


class MyDisplaysApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="com.mydisplays.app")
        self.connect("activate", lambda app: MyDisplaysWindow(application=app).present())


if __name__ == "__main__":
    if "--identify" in sys.argv:
        idx = sys.argv.index("--identify")
        name = sys.argv[idx + 1]
        mon_w = int(sys.argv[idx + 2])
        mon_h = int(sys.argv[idx + 3])
        safe_id = "com.mydisplays.identify." + name.replace("-", "_").replace(".", "_")
        app = Gtk.Application(application_id=safe_id)
        app.connect("activate", lambda app: show_identify_overlay(app, name, mon_w, mon_h))
        app.run()
        sys.exit(0)
    if not check_single_instance():
        print(_("MyDisplays ya está en ejecución."))
        sys.exit(0)
    app = MyDisplaysApp()
    app.run()
