    def _delete_profile(self, filename, dialog):
        path = os.path.join(PROFILES_DIR, filename)
        if os.path.exists(path):
            os.remove(path)
            logging.info(_("Perfil eliminado: {}").format(filename))
            self.toast_overlay.add_toast(Adw.Toast(title=_("Perfil eliminado")))
        dialog.close()
        self.refresh_profiles()
        remaining = []
        if os.path.isdir(PROFILES_DIR):
            for f in sorted(os.listdir(PROFILES_DIR)):
                if f.endswith(".conf"):
                    remaining.append(f)
        if remaining:
            self.on_load_profile()

    def on_monitor_selected(self, listbox, row):
        if not row:
            return
        self._editing_block = True
        m = row.monitor
        self.current_monitor = m
        self.canvas.select_monitor(m["name"])
        modes = get_monitor_modes(m["name"])
        str_list = Gtk.StringList.new(modes)
        self.res_combo.set_model(str_list)
        for i, mode in enumerate(modes):
            if mode_matches(mode, m["width"], m["height"], m["refresh"]):
                self.res_combo.set_selected(i)
                break
        self.scale_entry.set_text(str(m["scale"]))
        self.posx_entry.set_text(str(m["x"]))
        self.posy_entry.set_text(str(m["y"]))
        m_transform = m.get("transform", 0)
        base_rot = m_transform % 4
        mirrored = m_transform >= 4
        for ri, (_, rv) in enumerate(self.rot_options):
            if rv == base_rot:
                self.rot_combo.set_selected(ri)
                break
        self.mirror_switch.set_active(mirrored)
        self._editing_block = False

    def on_resolution_changed(self, combo, *args):
        if getattr(self, "_editing_block", False):
            return
        if not self.current_monitor:
            return
        m = self.current_monitor
        model = combo.get_model()
        if not model:
            return
        pos = combo.get_selected()
        if pos == Gtk.INVALID_LIST_POSITION:
            return
        mode = model.get_string(pos)
        w, h, hz = mode_to_resolution(mode)
        if self.would_overlap_size(m, w, h):
            for i, mode_str in enumerate(model):
                if mode_matches(mode_str, m["width"], m["height"], m["refresh"]):
                    self._editing_block = True
                    combo.set_selected(i)
                    self._editing_block = False
                    return
            self._editing_block = True
            combo.set_selected(Gtk.INVALID_LIST_POSITION)
            self._editing_block = False
        self.mark_dirty()

    def on_rotation_changed(self, combo, *args):
        if getattr(self, "_editing_block", False):
            return
        if not self.current_monitor:
            return
        self.mark_dirty()

    def on_mirror_toggled(self, switch, *args):
