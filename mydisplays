    def on_apply_profile(self, btn, filename):
        self.sync_combo_to_monitor()
        profile_path = os.path.join(PROFILES_DIR, filename)
        if not os.path.exists(profile_path):
            show_dialog(self, _("Error"), _("Perfil no encontrado"))
            return

        if os.path.exists(MONITOR_CONF):
            shutil.copy2(MONITOR_CONF, PRECONF)

        shutil.copy2(profile_path, MONITOR_CONF)
        ok, output = hyprctl_reload()

        if not ok:
            if os.path.exists(PRECONF):
                shutil.copy2(PRECONF, MONITOR_CONF)
                hyprctl_reload()
            show_dialog(self, _("Error al aplicar perfil"), output)
            logging.error(_("Aplicar perfil {}: {}").format(filename, output))
            self.refresh_monitors()
            return

        logging.info(_("Perfil aplicado: {}").format(filename))

        profile_name = filename.replace(".conf", "")
        dialog = Adw.MessageDialog.new(
            self,
            _("¿Funciona correctamente?"),
            _("Perfil: {}\nSe revertirá en 10 segundos si no confirmas.").format(profile_name),
        )
        dialog.add_response("no", _("No, revertir"))
        dialog.add_response("yes", _("Sí, mantener"))
        dialog.set_default_response("yes")
        dialog.set_response_appearance("yes", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_appearance("no", Adw.ResponseAppearance.DESTRUCTIVE)

        expired = [False]

        def on_response(d, resp):
            if expired[0]:
                return
            if resp == "yes":
                if os.path.exists(PRECONF):
                    os.remove(PRECONF)
                self.toast_overlay.add_toast(Adw.Toast(title=_("Perfil '{}' aplicado").format(profile_name)))
                logging.info(_("Perfil confirmado: {}").format(filename))
                self.refresh_monitors()
            else:
                self.restore_and_log(filename, profile_name)
            d.close()

        def on_close():
            if not expired[0]:
                self.restore_and_log(filename, profile_name)

        dialog.connect("close-request", on_close)
        dialog.present()

        # Timeout: revertir si no se confirma en 10s
        def on_timeout():
            expired[0] = True
            self.restore_and_log(filename, profile_name)
            dialog.close()
            return False

        GLib.timeout_add(10000, on_timeout)

        dialog.connect("response", on_response)
        dialog.connect("close-request", on_close)
        dialog.present()

    def restore_and_log(self, filename, profile_name):
        if os.path.exists(PRECONF):
            shutil.copy2(PRECONF, MONITOR_CONF)
            hyprctl_reload()
            os.remove(PRECONF)
            self.toast_overlay.add_toast(Adw.Toast(title=_("Perfil '{}' revertido").format(profile_name)))
