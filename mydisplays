    def mark_dirty(self):
        if not self._dirty:
            self._dirty = True
            self.save_btn.add_css_class("suggested-action")
            self.save_btn.remove_css_class("dim-label")
            self.cancel_btn.remove_css_class("dim-label")

    def clear_dirty(self):
        self._dirty = False
        self._saved_state = copy.deepcopy(self.monitors)
        self.save_btn.remove_css_class("suggested-action")
        self.save_btn.add_css_class("dim-label")
        self.cancel_btn.add_css_class("dim-label")

    def on_cancel(self, *args):
        if not self._dirty:
            return
        for m in self.monitors:
            saved = self._saved_state[0] if self._saved_state else None
            for s in self._saved_state:
                if s["name"] == m["name"]:
                    saved = s
                    break
            if saved:
                m.update(copy.deepcopy(saved))
        self.canvas.set_monitors(self.monitors)
        if self.current_monitor:
            for s in self._saved_state:
                if s["name"] == self.current_monitor["name"]:
                    self.current_monitor.update(copy.deepcopy(s))
                    break
            self._editing_block = True
            self.scale_entry.set_text(str(self.current_monitor["scale"]))
            self.posx_entry.set_text(str(self.current_monitor["x"]))
            self.posy_entry.set_text(str(self.current_monitor["y"]))
            self._editing_block = False
        self.clear_dirty()
        self.canvas.queue_draw()

    def identify_displays(self, *args):
        for m in self.monitors:
            name = m["name"]
            mon_w = int(m["width"] / m["scale"])
            mon_h = int(m["height"] / m["scale"])
            subprocess.Popen([
                "hyprctl", "dispatch", "exec",
                f"[monitor {name}] {SCRIPT_PATH} --identify {name} {mon_w} {mon_h}"
            ])

    def on_zoom_percent_changed(self, pct):
