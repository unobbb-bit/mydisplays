    def on_key_pressed(self, controller, keyval, keycode, state):
        ctrl = (state & Gdk.ModifierType.CONTROL_MASK) != 0
        if not ctrl:
            return Gdk.EVENT_PROPAGATE
        if keyval in (Gdk.KEY_KP_Add, Gdk.KEY_plus, Gdk.KEY_equal):
            self.adjust_zoom(10)
            return Gdk.EVENT_STOP
        if keyval in (Gdk.KEY_KP_Subtract, Gdk.KEY_minus):
            self.adjust_zoom(-10)
            return Gdk.EVENT_STOP
        return Gdk.EVENT_PROPAGATE

    def adjust_zoom(self, delta):
        canvas = self.canvas
        canvas.adjust_zoom(delta)
        mon = canvas.monitors
        if mon:
            lx_min = min(m["x"] for m in mon)
            lx_max = max(m["x"] + m["width"] / m["scale"] for m in mon)
            ly_min = min(m["y"] for m in mon)
            ly_max = max(m["y"] + m["height"] / m["scale"] for m in mon)
            sf = canvas.scale_factor
            self._zoom_target_w = (lx_max - lx_min) * sf + 150
            self._zoom_target_h = (ly_max - ly_min) * sf + 150
        GLib.idle_add(self._center_on_idle)

    def _center_on_idle(self):
        if not hasattr(self, '_zoom_target_w'):
            return False
        sw = self.scrolled
        hadj = sw.get_hadjustment()
        vadj = sw.get_vadjustment()
        vpw = hadj.get_page_size()
        vph = vadj.get_page_size()
        if vpw <= 0 or vph <= 0:
            return True
        if hadj.get_upper() < self._zoom_target_w - 0.5:
            return True
        hadj.set_value(max(0, (hadj.get_upper() - vpw) / 2))
        vadj.set_value(max(0, (vadj.get_upper() - vph) / 2))
        return False

    def center_canvas(self):
        sw = self.scrolled
        hadj = sw.get_hadjustment()
        vadj = sw.get_vadjustment()
        hadj.set_value(max(0, (hadj.get_upper() - hadj.get_page_size()) / 2))
        vadj.set_value(max(0, (vadj.get_upper() - vadj.get_page_size()) / 2))
        return False

    _last_warp_width = 0

    def do_size_allocate(self, width, height, baseline):
        Adw.ApplicationWindow.do_size_allocate(self, width, height, baseline)
        if hasattr(self, 'warp_group') and hasattr(self, 'btn_group'):
            bw = self.btn_group.get_allocated_width()
            if bw > 0 and bw != self._last_warp_width:
                self._last_warp_width = bw
                self.warp_group.set_size_request(bw, -1)
        is_portrait = height > width
        if is_portrait == getattr(self, '_is_portrait', False):
            return
        self._is_portrait = is_portrait
        if is_portrait:
            self.main_layout_box.set_orientation(Gtk.Orientation.VERTICAL)
            self.right_scroll.remove_css_class("right-panel-right")
            self.right_scroll.add_css_class("right-panel-bottom")
            self.right_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        else:
            self.main_layout_box.set_orientation(Gtk.Orientation.HORIZONTAL)
            self.right_scroll.remove_css_class("right-panel-bottom")
            self.right_scroll.add_css_class("right-panel-right")
            self.right_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        GLib.idle_add(self.canvas.ensure_clear_overlay)
        GLib.idle_add(self.center_canvas)

