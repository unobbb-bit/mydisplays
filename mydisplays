    def refresh_monitors(self):
        prev_name = self.current_monitor["name"] if self.current_monitor else None
        self.monitors = get_monitors()
        self.canvas.set_monitors(self.monitors)
        while True:
            row = self.monitor_list.get_first_child()
            if not row:
                break
            self.monitor_list.remove(row)
        for m in self.monitors:
            lbl = Gtk.Label(label=f"{m['name']}  {m['width']}x{m['height']}")
            lbl.set_xalign(0)
            row = Gtk.ListBoxRow()
            row.set_child(lbl)
            row.monitor = m
            self.monitor_list.append(row)
        self.refresh_overlap_warning()
        self.refresh_profiles()
        self.identify_btn.set_visible(len(self.monitors) > 1)
        if prev_name:
            self.select_monitor_by_name(prev_name)
        GLib.idle_add(self.center_canvas)

